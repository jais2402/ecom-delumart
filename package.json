{
  "name": "delulumart",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @delulu/web dev",
    "build": "pnpm --filter @delulu/web build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:setup": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/dev-setup.ts",
    "dev:age-reviews": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/dev-age-reviews.ts",
    "db:doctor": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/db-doctor.ts",
    "db:migrate:prod": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/db-migrate-prod.ts",
    "admin:grant": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/admin-grant.ts",
    "db:seed:prod": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/db-seed-prod.ts",
    "vercel:env": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/vercel-env.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
